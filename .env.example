# 数据库（docker/docker-compose.yml 中的 PostgreSQL）
DATABASE_URL="postgresql://talent360:talent360@localhost:5432/talent360"

# 认证模式：mock（开发）| feishu（生产）
AUTH_MODE=mock

# Session 签名密钥（至少 16 字符；生产环境必须更换为强随机值）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-strong-random-secret

# 飞书自建应用（AUTH_MODE=feishu 时必填；生产环境必须用 feishu，mock 会拒绝启动）
# 取开发者后台 → 凭证与基础信息 → App ID / App Secret
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 须与开发者后台「安全设置 → 重定向 URL」完全一致
FEISHU_REDIRECT_URI=http://localhost:3001/api/auth/feishu/callback
# 端点基址（一般无需修改）：OAuth 授权/令牌在 accounts 域，user_info 在 open 域
FEISHU_ACCOUNTS_BASE_URL=https://accounts.feishu.cn
FEISHU_API_BASE_URL=https://open.feishu.cn
# 需用户授权的 scope（空格分隔，取自开发者后台「权限管理」）；留空则不传 scope 参数
# 例：contact:user.base:readonly contact:user.employee_id:readonly
FEISHU_SCOPES=

# 飞书多维表格同步
FEISHU_BITABLE_ENABLED=false
