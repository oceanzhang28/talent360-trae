generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 系统角色：全局权限（HR 项目管理员不在此处，通过 ProjectAdmin 管理）
enum SystemRole {
  SYSTEM_ADMIN
  USER
}

// 项目状态机（PRD 6.2）：DRAFT -> PUBLISHED -> ACTIVE -> CLOSED -> FROZEN -> ARCHIVED
// DELETED 为软删除标记（技术文档第 58 节），不参与正常状态流转
enum ProjectStatus {
  DRAFT // 草稿：HR 配置阶段
  PUBLISHED // 已发布：尚未到开始时间
  ACTIVE // 测评中：员工可填写评价
  CLOSED // 已截止：员工不能继续提交
  FROZEN // 已冻结：正式测评结果（评分快照 Sprint 8 补充）
  ARCHIVED // 已归档：历史项目
  DELETED // 软删除：deletedAt + purgeAfter（+30 天）
}

// 题型（技术文档第 15 节）：RATING 固定 10 档量表必答；TEXT 开放题可配置必填/选填
enum QuestionType {
  RATING
  TEXT
}

// 系统登录用户（身份匹配见技术文档第 7 节：飞书 OAuth -> employeeNo）
model User {
  id            String         @id @default(cuid())
  feishuOpenId  String?        @unique
  feishuUnionId String?
  employeeNo    String?        @unique
  name          String
  systemRole    SystemRole     @default(USER)
  department    String?        // 部门（人员初始化配置，全局主数据）
  position      String?        // 岗位
  grade         String?        // 职级
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectAdmins ProjectAdmin[]
}

// 测评项目（单公司内部工具，任何登录用户可创建，创建者自动成为项目管理员）
model Project {
  id                       String           @id @default(cuid())
  name                     String
  description              String?          @db.Text
  questionnaireInstruction String?          @db.Text
  startAt                  DateTime?
  endAt                    DateTime?
  status                   ProjectStatus    @default(DRAFT)
  selfReviewEnabled        Boolean          @default(true)
  managerWeight            Decimal          @default(40) @db.Decimal(5, 2)
  peerWeight               Decimal          @default(30) @db.Decimal(5, 2)
  subordinateWeight        Decimal          @default(30) @db.Decimal(5, 2)
  frozenAt                 DateTime?
  frozenBy                 String?
  deletedAt                DateTime?
  purgeAfter               DateTime?
  // 软删除前的状态（PRD 第 44 节回收站：恢复时还原到删除前状态）
  statusBeforeDelete       ProjectStatus?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  admins        ProjectAdmin[]
  scales        ProjectScale[]
  questionnaire Questionnaire?
  people        ProjectPerson[]
  relations     ReviewRelation[]
  tasks         ReviewTask[]
  resultSnapshots ResultSnapshot[]
}

// 项目管理员（HR）：项目级权限，系统管理员天然拥有所有项目权限
model ProjectAdmin {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// 评分档位（PRD 第 10 节）：固定 10 档 0.5~5.0，HR 只能改 label，不能增删档位
model ProjectScale {
  id        String  @id @default(cuid())
  projectId String
  value     Decimal @db.Decimal(3, 1)
  label     String
  order     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, value])
}

// 问卷（技术文档第 13 节）：projectId 为空 = 模板；首次正式提交后 lockedAt 锁定禁止修改
model Questionnaire {
  id           String    @id @default(cuid())
  projectId    String?   @unique
  templateName String?
  isTemplate   Boolean   @default(false)
  // 模板创建者（PRD 第 13 节模板库归属；改名/删除限创建者或系统管理员）。项目问卷为空；
  // 与 Project.frozenBy 同样只存用户 id，不建外键
  createdById  String?
  lockedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project     Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dimensions  Dimension[]

  @@index([isTemplate])
}

// 维度（技术文档第 14 节）：树状最大两级；parentId 为空 = 一级维度
// 同一一级维度不能同时直接挂题目和二级维度（避免评分歧义，service 层校验）
model Dimension {
  id              String  @id @default(cuid())
  questionnaireId String
  parentId        String?
  name            String
  description     String? @db.Text
  weight          Decimal @default(0) @db.Decimal(5, 2)
  order           Int     @default(0)
  // 关系适用规则（PRD 第 11 节）：维度级默认，题目级可 override
  applicableSelf        Boolean @default(true)
  applicableManager     Boolean @default(true)
  applicablePeer        Boolean @default(true)
  applicableSubordinate Boolean @default(true)

  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  parent        Dimension?    @relation("DimensionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      Dimension[]   @relation("DimensionTree")
  questions     Question[]

  @@index([questionnaireId])
  @@index([parentId])
}

// 题目（技术文档第 15 节）：RATING 固定 10 档必答；TEXT 开放题 weight=null、可配置必填/选填
model Question {
  id                    String       @id @default(cuid())
  dimensionId           String
  type                  QuestionType
  code                  String
  title                 String       @db.Text
  description           String?      @db.Text
  weight                Decimal?     @db.Decimal(5, 2)
  required              Boolean      @default(true)
  order                 Int          @default(0)
  overrideRelationRules Boolean      @default(false)
  applicableSelf        Boolean      @default(true)
  applicableManager     Boolean      @default(true)
  applicablePeer        Boolean      @default(true)
  applicableSubordinate Boolean      @default(true)

  dimension    Dimension         @relation(fields: [dimensionId], references: [id], onDelete: Cascade)
  draftAnswers DraftAnswer[]
  submissionAnswers SubmissionAnswer[]

  @@unique([dimensionId, code])
  @@index([dimensionId])
}

// 评价关系类型（技术文档第 17 节）：始终从被评人视角定义（李四评价张三 = 上级）
enum RelationType {
  SELF
  MANAGER
  PEER
  SUBORDINATE
}

// 评价任务状态机（技术文档第 18 节）：NOT_STARTED → IN_PROGRESS → SUBMITTED ⇄ RETURNED
enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  RETURNED
}

// 草稿答案（技术文档第 19 节）：只保存评价人当前草稿。
// 铁律 4：DraftAnswer 永远不能通过任何 HR API 暴露（无 HR 读取接口）
model DraftAnswer {
  id         String    @id @default(cuid())
  taskId     String
  questionId String
  score      Decimal?  @db.Decimal(3, 1)
  textValue  String?   @db.Text
  updatedAt  DateTime  @updatedAt

  task     ReviewTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([taskId, questionId])
  @@index([taskId])
}

// 正式提交（技术文档第 20 节）：每次提交生成一个版本，历史版本保留
// 退回重评后重新提交 → version+1；旧版本 invalidatedAt 标记，计算使用当前有效版本
model Submission {
  id             String    @id @default(cuid())
  taskId         String
  version        Int
  submittedAt    DateTime  @default(now())
  invalidatedAt  DateTime?
  invalidReason  String?

  task     ReviewTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  answers  SubmissionAnswer[]

  @@unique([taskId, version])
  @@index([taskId])
}

// 提交答案快照（技术文档第 21 节）：提交时从 DraftAnswer 复制，不再随草稿变化
model SubmissionAnswer {
  id           String   @id @default(cuid())
  submissionId String
  questionId   String
  score        Decimal? @db.Decimal(3, 1)
  textValue    String?  @db.Text

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

// 审计动作（技术文档第 25 节）：仅关键操作
enum AuditAction {
  RETURN_REVIEW
  DELETE_RELATION
  CHANGE_RELATION
  FREEZE_PROJECT
  UNFREEZE_PROJECT
  EXPORT_RESULTS
  SYNC_FEISHU
  DELETE_PROJECT
  RESTORE_PROJECT
}

// 项目人员快照（技术文档第 12 节 / PRD 第 19 节）：每项目独立，unique(projectId, employeeNo)
// 修改一个项目的人员信息不影响其他项目历史记录（铁律 6）
model ProjectPerson {
  id           String   @id @default(cuid())
  projectId    String
  employeeNo   String
  name         String
  department   String?
  position     String?
  grade        String?
  feishuOpenId String?
  createdAt    DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // 同一人可同时是被评人与评价人：两个自关联方向
  revieweeRelations ReviewRelation[] @relation("Reviewee")
  reviewerRelations ReviewRelation[] @relation("Reviewer")
  resultSnapshots  ResultSnapshot[] @relation("ResultReviewee")

  @@unique([projectId, employeeNo])
  @@index([projectId])
}

// 评价关系（技术文档第 17 节）：每条关系对应一份评价任务
// 删除已完成关系 → active=false 软删除（提交历史保留，评分时排除；PRD 第 20 节）
model ReviewRelation {
  id               String       @id @default(cuid())
  projectId        String
  revieweePersonId String
  reviewerPersonId String
  relationType     RelationType
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewee ProjectPerson  @relation("Reviewee", fields: [revieweePersonId], references: [id], onDelete: Cascade)
  reviewer ProjectPerson  @relation("Reviewer", fields: [reviewerPersonId], references: [id], onDelete: Cascade)
  tasks    ReviewTask[]

  // 同一评价人 + 被评人在同一项目中只能有一种关系（PRD 第 17 节）
  @@unique([projectId, revieweePersonId, reviewerPersonId])
  @@index([projectId])
  @@index([reviewerPersonId])
}

// 评价任务（技术文档第 18 节）
model ReviewTask {
  id                       String     @id @default(cuid())
  projectId                String
  relationId               String     @unique
  status                   TaskStatus @default(NOT_STARTED)
  startedAt                DateTime?
  submittedAt              DateTime?
  returnedAt               DateTime?
  currentSubmissionVersion Int?

  relation ReviewRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drafts   DraftAnswer[]
  submissions Submission[]

  @@index([projectId])
}

// 审计日志（技术文档第 25 节）：projectId/actorUserId 不建外键，项目或用户删除后审计保留
model AuditLog {
  id           String      @id @default(cuid())
  actorUserId  String
  projectId    String?
  action       AuditAction
  entityType   String
  entityId     String?
  metadataJson String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([projectId])
  @@index([createdAt])
}

// 结果快照（技术文档第 22 节）：冻结项目时生成，报告只读此表。
// 后续修改业务表不影响已冻结结果；重算仅在重新冻结时整体替换。
// 得分存储 6 位小数（展示层固定 2 位），无得分（无有效关系/提交）为 null。
model ResultSnapshot {
  id               String    @id @default(cuid())
  projectId        String
  revieweePersonId String
  totalScore       Decimal?  @db.Decimal(8, 6) // 360 总分（仅他评关系加权，铁律 7）
  selfScore        Decimal?  @db.Decimal(8, 6)
  managerScore     Decimal?  @db.Decimal(8, 6)
  peerScore        Decimal?  @db.Decimal(8, 6)
  subordinateScore Decimal?  @db.Decimal(8, 6)
  expectedCount    Int // 应评价任务数（active 关系数）
  submittedCount   Int // 已提交任务数
  completionRate   Decimal?  @db.Decimal(8, 6) // submittedCount / expectedCount
  createdAt        DateTime  @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewee   ProjectPerson     @relation("ResultReviewee", fields: [revieweePersonId], references: [id], onDelete: Cascade)
  dimensions ResultDimension[]
  questions  ResultQuestion[]

  @@unique([projectId, revieweePersonId])
  @@index([projectId])
}

// 维度得分快照（技术文档第 23 节）：一级/二级维度 × 关系。
// 只落有得分的行（可见但无有效数据的不存，读取时按问卷结构补 null 展示）。
model ResultDimension {
  id               String       @id @default(cuid())
  resultSnapshotId String
  dimensionId      String
  relationType     RelationType
  score            Decimal      @db.Decimal(8, 6)

  snapshot ResultSnapshot @relation(fields: [resultSnapshotId], references: [id], onDelete: Cascade)

  @@unique([resultSnapshotId, dimensionId, relationType])
  @@index([resultSnapshotId])
}

// 题目得分快照（技术文档第 24 节）：RATING 题平均分 × 关系。
// TEXT 题不参与计分不落快照，原文在评价人实名明细（SubmissionAnswer）查看。
model ResultQuestion {
  id               String       @id @default(cuid())
  resultSnapshotId String
  questionId       String
  relationType     RelationType
  score            Decimal      @db.Decimal(8, 6)

  snapshot ResultSnapshot @relation(fields: [resultSnapshotId], references: [id], onDelete: Cascade)

  @@unique([resultSnapshotId, questionId, relationType])
  @@index([resultSnapshotId])
}
